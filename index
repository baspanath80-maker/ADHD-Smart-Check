            <input type="radio" name="q25" id="q25_3" value="3" /><label for="q25_3"><i class="fa-solid fa-face-grimace"></i>มาก <span>(3)</span></label>  
          </div>  
        </div>  

        <div class="question"><label>26. เจ้าคิดเจ้าแค้น</label>  
          <div class="options-inline">  
            <input type="radio" name="q26" id="q26_0" value="0" required /><label for="q26_0"><i class="fa-regular fa-face-smile"></i>ไม่เลย <span>(0)</span></label>  
            <input type="radio" name="q26" id="q26_1" value="1" /><label for="q26_1"><i class="fa-regular fa-face-meh"></i>เล็กน้อย <span>(1)</span></label>  
            <input type="radio" name="q26" id="q26_2" value="2" /><label for="q26_2"><i class="fa-regular fa-face-frown"></i>ค่อนข้างมาก <span>(2)</span></label>  
            <input type="radio" name="q26" id="q26_3" value="3" /><label for="q26_3"><i class="fa-solid fa-face-grimace"></i>มาก <span>(3)</span></label>  
          </div>  
        </div>  
      </div>    

      <div class="form-buttons">  
        <button type="button" onclick="calculateAndDisplay()" id="calculateButton"><i class="fa-solid fa-calculator"></i> คำนวณผลคะแนนและแปลผล</button>  
        <button type="button" onclick="printReport()" id="printButton"><i class="fa-solid fa-print"></i> พิมพ์รายงาน</button>  
        <button type="button" onclick="resetForm()" id="resetButton"><i class="fa-solid fa-trash-can"></i> รีเซตข้อมูล</button>  
      </div>  
    </form>  

    <div id="printResult">  
      <div class="result-header">  
        <i class="fa-solid fa-square-poll-vertical" style="font-size: 26px;"></i>  
        <h2>สรุปผลการประเมินพฤติกรรม ADHD Smart Screen (SNAP-IV)</h2>  
      </div>    
      <div class="patient-info-summary">  
        <div><strong>ชื่อผู้รับบริการ:</strong> <span id="displayName"></span></div>  
        <div><strong>วันที่ประเมิน:</strong> <span id="displayDate"></span></div>  
        <div><strong>ระดับการศึกษา:</strong> <span id="displayEducation"></span></div>  
        <div><strong>ประเมินโดย:</strong> <span id="displayAssessor"></span></div>  
      </div>    
      <div id="displaySummary"></div>    
      <div id="descriptionPrint" style="margin-top: 25px; padding: 15px 20px; background-color: #f1f5f9; border-radius: 12px; font-size: 14px; border: 1px solid #e2e8f0;">  
        <h4 style="color:var(--primary-dark); margin: 0 0 8px 0; font-size: 15px;"><i class="fa-solid fa-circle-exclamation"></i> เกณฑ์การแปลผลที่ใช้อ้างอิง (Cutoff Score)</h4>  
        <p style="margin: 3px 0;"><strong>สำหรับผู้ปกครอง:</strong> ขาดสมาธิ ≥ 16 คะแนน, ซน/หุนหันพลันแล่น ≥ 14 คะแนน, ดื้อต่อต้าน ≥ 12 คะแนน</p>  
        <p style="margin: 3px 0;"><strong>สำหรับครู:</strong> ขาดสมาธิ ≥ 18 คะแนน, ซน/หุนหันพลันแล่น ≥ 11 คะแนน, ดื้อต่อต้าน ≥ 8 คะแนน</p>  
      </div>    
      <div id="printTable"></div>  
    </div>  
  </div>   

  <script>  
  function formatDate(dateString) {  
      if (!dateString) return '';  
      const parts = dateString.split('-');   
      const year = parts[0];   
      const month = parts[1];  
      const day = parts[2];  
      return `${day}/${month}/${year}`;  
  }  
    
  function calculateAndDisplay() {  
    const form = document.forms['snapForm'];  
    const assessor = document.querySelector('input[name="assessor"]:checked');  
    const educationLevel = document.getElementById('educationLevel');  
      
    if (!assessor || !educationLevel.value || !form.name.value || !form.date.value) {  
      alert('กรุณากรอกข้อมูลพื้นฐานและเลือกผู้ประเมินให้ครบถ้วน');  
      return false;   
    }  
    const assessorType = assessor.value;  
    
    let inattention = 0, hyperactivity = 0, oppositional = 0;  
      
    const allQuestions = document.querySelectorAll('.question');  
    allQuestions.forEach(q => {  
      q.style.borderBottom = '1px solid #edf2f7';  
      q.style.backgroundColor = 'transparent';  
    });  
    
    let firstUnansweredQuestionIndex = -1;  
    
    for(let i = 1; i <= 26; i++) {  
      const qName = 'q' + i;  
      const q = form[qName];  
      let val = null;  
      let isChecked = false;  
    
      if (q) {  
        for (const ele of q) {  
          if (ele.checked) {  
            val = parseInt(ele.value);  
            isChecked = true;  
            break;  
          }  
        }  
      }  
        
      if (!isChecked && firstUnansweredQuestionIndex === -1) {  
        firstUnansweredQuestionIndex = i;  
      }  
        
      if (isChecked) {  
        if (i <= 9) inattention += val;  
        else if (i <= 18) hyperactivity += val;  
        else oppositional += val;  
      }  
    }  
    
    if (firstUnansweredQuestionIndex !== -1) {  
      alert('กรุณาตอบคำถามข้อที่ ' + firstUnansweredQuestionIndex + ' ให้ครบถ้วน');  
      const firstUnansweredQuestion = document.querySelector(`input[name="q${firstUnansweredQuestionIndex}"]`).closest('.question');  
      if (firstUnansweredQuestion) {  
          firstUnansweredQuestion.style.backgroundColor = '#fef2f2';  
          firstUnansweredQuestion.scrollIntoView({ behavior: 'smooth', block: 'center' });  
      }  
      return false;   
    }  
    
    const cutoffs = {  
      "ผู้ปกครอง": {inattention: 16, hyperactivity: 14, oppositional: 12},  
      "ครู": {inattention: 18, hyperactivity: 11, oppositional: 8}  
    };  
    
    const cutoff = cutoffs[assessorType];  
      
    const inattentionStatus = inattention >= cutoff.inattention;  
    const hyperactivityStatus = hyperactivity >= cutoff.hyperactivity;  
    const oppositionalStatus = oppositional >= cutoff.oppositional;  
      
    let summaryHTML = `  
      <p>  
          <span><i class="fa-solid fa-head-side-virus" style="color:var(--inattention-color); margin-right:8px;"></i> <strong>ด้านขาดสมาธิ (1-9):</strong> คะแนนรวม ${inattention} คะแนน (เกณฑ์สำหรับ${assessorType} ≥ ${cutoff.inattention})</span>  
          ${inattentionStatus ? `<span class="status-badge risk-badge"><i class="fa-solid fa-triangle-exclamation"></i> เสี่ยง</span>` : `<span class="status-badge normal-badge"><i class="fa-solid fa-circle-check"></i> ปกติ</span>`}  
      </p>  
      <p>  
          <span><i class="fa-solid fa-child-holding-hands" style="color:var(--hyperactivity-color); margin-right:8px;"></i> <strong>ด้านซน/หุนหันพลันแล่น (10-18):</strong> คะแนนรวม ${hyperactivity} คะแนน (เกณฑ์สำหรับ${assessorType} ≥ ${cutoff.hyperactivity})</span>  
          ${hyperactivityStatus ? `<span class="status-badge risk-badge"><i class="fa-solid fa-triangle-exclamation"></i> เสี่ยง</span>` : `<span class="status-badge normal-badge"><i class="fa-solid fa-circle-check"></i> ปกติ</span>`}  
      </p>  
      <p>  
          <span><i class="fa-solid fa-face-angry" style="color:var(--oppositional-color); margin-right:8px;"></i> <strong>ด้านดื้อต่อต้าน (19-26):</strong> คะแนนรวม ${oppositional} คะแนน (เกณฑ์สำหรับ${assessorType} ≥ ${cutoff.oppositional})</span>  
          ${oppositionalStatus ? `<span class="status-badge risk-badge"><i class="fa-solid fa-triangle-exclamation"></i> เสี่ยง</span>` : `<span class="status-badge normal-badge"><i class="fa-solid fa-circle-check"></i> ปกติ</span>`}  
      </p>  
    `;  
    
    let tableHTML = `<table class="result-table">  
      <thead>  
        <tr>  
          <th>ด้านที่ประเมิน</th>  
          <th style="text-align: center;">คะแนนที่ได้ (เต็ม)</th>  
          <th style="text-align: center;">เกณฑ์ตัดสินจุดตัด (Cut-off)</th>  
          <th style="text-align: center;">ผลการแปลความหมาย</th>  
        </tr>  
      </thead>  
      <tbody>  
        <tr class="${inattentionStatus ? 'invalid-result' : 'valid-result'}">  
          <td>ด้านขาดสมาธิ (Inattention) (ข้อ 1-9)</td>  
          <td style="text-align: center; font-weight: 500;">${inattention} (27)</td>  
          <td style="text-align: center;">≥ ${cutoff.inattention}</td>  
          <td style="text-align: center;">${inattentionStatus ? 'เสี่ยง' : 'ปกติ'}</td>  
        </tr>  
        <tr class="${hyperactivityStatus ? 'invalid-result' : 'valid-result'}">  
          <td>ด้านซน อยู่ไม่นิ่ง/หุนหันพลันแล่น (Hyperactivity) (ข้อ 10-18)</td>  
          <td style="text-align: center; font-weight: 500;">${hyperactivity} (27)</td>  
          <td style="text-align: center;">≥ ${cutoff.hyperactivity}</td>  
          <td style="text-align: center;">${hyperactivityStatus ? 'เสี่ยง' : 'ปกติ'}</td>  
        </tr>  
        <tr class="${oppositionalStatus ? 'invalid-result' : 'valid-result'}">  
          <td>ด้านดื้อต่อต้าน (Oppositional Defiant Disorder) (ข้อ 19-26)</td>  
          <td style="text-align: center; font-weight: 500;">${oppositional} (24)</td>  
          <td style="text-align: center;">≥ ${cutoff.oppositional}</td>  
          <td style="text-align: center;">${oppositionalStatus ? 'เสี่ยง' : 'ปกติ'}</td>  
        </tr>  
      </tbody>  
    </table>`;  
    
    const formattedDate = formatDate(form.date.value);  
      
    document.getElementById('displaySummary').innerHTML = summaryHTML;  
    document.getElementById('printTable').innerHTML = tableHTML;  
      
    document.getElementById('displayName').textContent = form.name.value;  
    document.getElementById('displayDate').textContent = formattedDate;   
    document.getElementById('displayEducation').textContent = educationLevel.value;  
    document.getElementById('displayAssessor').textContent = assessorType;  
      
    document.getElementById('printResult').style.display = 'block';  
    document.getElementById('printResult').scrollIntoView({ behavior: 'smooth' });  
      
    return true;   
  }  
    
  function printReport() {  
      const calculationSuccessful = calculateAndDisplay();  
      if (!calculationSuccessful) return;   
    
      const reportContent = document.getElementById('printResult').innerHTML;  
      const name = document.getElementById('displayName').textContent;  
    
      const htmlContent = `  
          <html>  
          <head>  
              <title>รายงานผล ADHD Smart Screen (${name})</title>  
              <meta charset="UTF-8" />  
              <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;600;700&display=swap" rel="stylesheet">  
              <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
              <style>  
                  body { font-family: 'Sarabun', sans-serif; padding: 20px; color: #333; margin: 1cm; font-size: 16px; }  
                  h1 { color: #1565c0; text-align: center; margin-bottom: 5px; font-size: 24px;}  
                  h2 { color: #1565c0; text-align: center; margin-top: 5px; border-bottom: 2px solid #1565c0; padding-bottom: 10px; font-size: 20px;}  
                  h4 { color: #1565c0; margin-top: 20px; border-bottom: 1px dashed #ccc; padding-bottom: 3px;}  
                  p { margin: 8px 0; font-size: 15px; }  
                  .patient-info-summary { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; background: #f8fafc; padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #e2e8f0;}  
                  .result-table { width: 100%; border-collapse: collapse; margin-top: 15px; }  
                  .result-table th, .result-table td { border: 1px solid #333; padding: 10px; font-size: 15px; }  
                  .result-table th { background-color: #e3f2fd; color: #000; text-align: center; font-weight: bold; }  
                  .risk { color: #d32f2f !important; font-weight: bold; -webkit-print-color-adjust: exact; print-color-adjust: exact; }   
                  .normal { color: #388e3c !important; font-weight: bold; -webkit-print-color-adjust: exact; print-color-adjust: exact; }   
                  .valid-result td:last-child { color: #388e3c !important; font-weight: bold; text-align: center; -webkit-print-color-adjust: exact; print-color-adjust: exact; }   
                  .invalid-result td:last-child { color: #d32f2f !important; font-weight: bold; text-align: center; -webkit-print-color-adjust: exact; print-color-adjust: exact; }  
                  #displaySummary { display: none; }   
                  #printResult { display: block; border: none; padding: 0;}  
                  #printTable { display: block; }   
              </style>  
          </head>  
      <body>  
          <h1>ADHD Smart Screen (SNAP-IV)</h1>  
          <p style="text-align: center; margin-bottom: 25px; color:#555;">โรงพยาบาลดอนจาน - รายงานสรุปผลการคัดกรอง</p>  
          ${reportContent}  
      </body>  
      </html>  
  `;  

  const printWindow = window.open('', '', 'height=700,width=900');  
  printWindow.document.write(htmlContent);  
  printWindow.document.close();  
  printWindow.focus();  
  printWindow.print();
  }

  function resetForm() {
    if (!confirm("คุณแน่ใจหรือไม่ว่าต้องการรีเซ็ตข้อมูลทั้งหมด?")) {
      return;
    }

    document.getElementById('snapForm').reset();
    document.getElementById('printResult').style.display = 'none';
    document.getElementById('displaySummary').innerHTML = '';
    document.getElementById('printTable').innerHTML = '';

    const questions = document.querySelectorAll('.question');
    questions.forEach(q => {
      q.style.borderBottom = '1px solid #edf2f7';
      q.style.backgroundColor = 'transparent';
    });

    document.getElementById('mainContainer').scrollIntoView({ behavior: 'smooth' });
  }
  </script>
</body>  
</html>


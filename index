<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#1e88e5">
<meta name="description" content="ADHD Smart Screen (SNAP-IV) ระบบคัดกรองภาวะสมาธิสั้นพร้อมแปลผลอัตโนมัติ โรงพยาบาลดอนจาน">

<!-- Android / PWA -->
<link rel="manifest" href="./manifest.json">
<link rel="icon" type="image/png" sizes="192x192" href="./192.png">
<link rel="icon" type="image/png" sizes="512x512" href="./512.png">

<!-- iPhone / iPad -->
<link rel="apple-touch-icon" sizes="180x180" href="./180.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="ADHD Smart Check">

<title>ADHD Smart Screen (SNAP-IV)</title>

<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
:root {
  --primary:#1e88e5;
  --primary-dark:#1565c0;
  --primary-light:#e3f2fd;
  --text-main:#2c3e50;
  --text-muted:#7f8c8d;
  --bg-body:#f4f7f9;
  --card-bg:#fff;
  --shadow-soft:0 15px 35px rgba(21,101,192,.08);
  --shadow-card:0 8px 25px rgba(0,0,0,.06);
  --transition-bounce:cubic-bezier(.175,.885,.32,1.275);

  --inattention-color:#ff4a5a;
  --hyperactivity-color:#29b6f6;
  --oppositional-color:#ff9800;

  --success-color:#2e7d32;
  --danger-color:#c62828;

  --lvl-0:#2e7d32;
  --lvl-1:#f59f00;
  --lvl-2:#e65100;
  --lvl-3:#c62828;
}

* {
  box-sizing:border-box;
}

body {
  font-family:'Sarabun',sans-serif;
  margin:0;
  padding:30px 15px;
  background:var(--bg-body);
  color:var(--text-main);
  line-height:1.6;
}

.container {
  max-width:850px;
  margin:0 auto;
  background:var(--card-bg);
  padding:40px;
  border-radius:24px;
  box-shadow:var(--shadow-soft);
  border:1px solid rgba(21,101,192,.08);
}

.header-brand {
  text-align:center;
  margin-bottom:40px;
}

.brand-icon {
  font-size:45px;
  color:var(--primary);
  background:var(--primary-light);
  width:100px;
  height:100px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:50px;
  margin:0 auto 15px;
  box-shadow:inset 0 0 10px rgba(30,136,229,.1);
  animation:pulse 2s infinite ease-in-out;
}

@keyframes pulse {
  0%,100% { transform:scale(1); }
  50% { transform:scale(1.05); }
}

h1 {
  color:var(--primary-dark);
  margin:0 0 5px;
  font-size:32px;
  font-weight:700;
  letter-spacing:-.5px;
}

.subtitle {
  color:var(--text-muted);
  font-size:16px;
  margin:0;
  font-weight:500;
}

h2 {
  color:var(--text-main);
  font-size:20px;
  margin-bottom:25px;
  display:flex;
  align-items:center;
  gap:10px;
}

h3 {
  color:var(--primary-dark);
  margin:0 0 20px;
  padding:14px 20px;
  background:var(--primary-light);
  border-radius:14px;
  font-size:18px;
  display:flex;
  align-items:center;
  gap:10px;
}

.info-grid {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:20px;
  margin-bottom:30px;
  background:#f8fafc;
  padding:25px;
  border-radius:18px;
  border:1px solid #edf2f7;
}

.info-group {
  display:flex;
  flex-direction:column;
}

label {
  margin-bottom:8px;
  font-weight:600;
  font-size:15px;
  color:#4a5568;
}

input[type=text],
input[type=date],
select {
  width:100%;
  padding:12px 16px;
  border:1.5px solid #e2e8f0;
  border-radius:12px;
  box-sizing:border-box;
  font-size:15px;
  font-family:'Sarabun',sans-serif;
  background:#fff;
  color:var(--text-main);
  transition:all .3s var(--transition-bounce);
}

input[type=text]:focus,
input[type=date]:focus,
select:focus {
  border-color:var(--primary);
  outline:0;
  box-shadow:0 0 0 4px rgba(30,136,229,.15);
  transform:translateY(-1px);
}

.assessor-options {
  display:flex;
  gap:15px;
  margin-top:5px;
}

.assessor-box {
  flex:1;
  position:relative;
}

.assessor-box input[type=radio] {
  position:absolute;
  opacity:0;
  width:100%;
  height:100%;
  cursor:pointer;
  z-index:2;
}

.assessor-box label {
  display:flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  padding:12px;
  background:#fff;
  border:1.5px solid #e2e8f0;
  border-radius:12px;
  text-align:center;
  cursor:pointer;
  transition:all .25s var(--transition-bounce);
  font-weight:500;
  margin:0;
}

.assessor-box input[type=radio]:checked+label {
  background:var(--primary-light);
  border-color:var(--primary);
  color:var(--primary-dark);
  font-weight:600;
  transform:scale(1.03);
  box-shadow:0 4px 10px rgba(30,136,229,.1);
}

.instruction-banner {
  font-weight:500;
  margin:35px 0;
  padding:18px 25px;
  background:#fff9db;
  border-left:5px solid #fcc419;
  border-radius:0 14px 14px 0;
  font-size:15px;
  color:#665200;
  display:flex;
  gap:15px;
  align-items:flex-start;
  box-shadow:0 4px 10px rgba(252,196,25,.05);
}

.instruction-banner i.banner-icon {
  font-size:20px;
  color:#f59f00;
  margin-top:2px;
}

.instruction-legend {
  margin-top:8px;
  display:flex;
  gap:15px;
  flex-wrap:wrap;
  font-weight:600;
}

.instruction-legend span {
  display:inline-flex;
  align-items:center;
  gap:5px;
}

.question-group {
  padding:10px 0;
  margin-bottom:35px;
  border-radius:16px;
  background:#fff;
}

.question {
  margin-bottom:0;
  padding:22px 0;
  background:transparent;
  border:none;
  border-bottom:1px solid #edf2f7;
  transition:all .25s ease;
}

.question:last-child {
  border-bottom:none;
}

.question>label {
  display:block;
  font-size:16px;
  font-weight:600;
  margin-bottom:15px;
  color:var(--text-main);
}

.options-inline {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
  margin-top:12px;
}

.options-inline input[type=radio] {
  position:absolute;
  opacity:0;
}

.options-inline label {
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:10px 4px;
  border:1.5px solid #e2e8f0;
  border-radius:14px;
  cursor:pointer;
  transition:all .25s var(--transition-bounce);
  font-weight:500;
  font-size:13px;
  background:#fff;
  color:#4a5568;
  margin:0;
  text-align:center;
  gap:4px;
}

.options-inline label i {
  font-size:22px;
  margin-bottom:2px;
  transition:transform .2s ease;
}

.options-inline label[for$="_0"] i {
  color:var(--lvl-0);
}

.options-inline label[for$="_1"] i {
  color:var(--lvl-1);
}

.options-inline label[for$="_2"] i {
  color:var(--lvl-2);
}

.options-inline label[for$="_3"] i {
  color:var(--lvl-3);
}

.options-inline label:hover {
  background:#f8fafc;
  border-color:#cbd5e1;
  transform:translateY(-2px);
}

.options-inline label:hover i {
  transform:scale(1.15);
}

.options-inline input[type=radio]:checked+label {
  color:#fff;
  box-shadow:0 6px 15px rgba(0,0,0,.15);
  font-weight:600;
  transform:translateY(-3px) scale(1.02);
}

.options-inline input[type=radio]:checked+label i {
  color:#fff!important;
  transform:scale(1.1);
}

.options-inline input[type=radio][value="0"]:checked+label {
  background:var(--lvl-0);
  border-color:#1b5e20;
  box-shadow:0 6px 15px rgba(46,125,50,.3);
}

.options-inline input[type=radio][value="1"]:checked+label {
  background:var(--lvl-1);
  border-color:#e67e22;
  box-shadow:0 6px 15px rgba(245,159,0,.3);
}

.options-inline input[type=radio][value="2"]:checked+label {
  background:var(--lvl-2);
  border-color:#d35400;
  box-shadow:0 6px 15px rgba(230,81,0,.3);
}

.options-inline input[type=radio][value="3"]:checked+label {
  background:var(--lvl-3);
  border-color:#b71c1c;
  box-shadow:0 6px 15px rgba(198,40,40,.3);
}

.form-buttons {
  display:flex;
  gap:15px;
  margin-top:40px;
  justify-content:center;
}

.form-buttons button {
  padding:14px 28px;
  color:#fff;
  border:none;
  border-radius:14px;
  cursor:pointer;
  font-size:16px;
  font-weight:600;
  display:inline-flex;
  align-items:center;
  gap:10px;
  transition:all .25s var(--transition-bounce);
  box-shadow:0 4px 10px rgba(0,0,0,.08);
}

#calculateButton {
  background:var(--primary);
  width:50%;
  justify-content:center;
}

#calculateButton:hover {
  background:var(--primary-dark);
  transform:translateY(-3px);
  box-shadow:0 8px 20px rgba(30,136,229,.4);
}

#printButton {
  background:#475569;
}

#printButton:hover {
  background:#334155;
  transform:translateY(-3px);
  box-shadow:0 8px 15px rgba(71,85,105,.3);
}

#resetButton {
  background:#ef4444;
}

#resetButton:hover {
  background:#dc2626;
  transform:translateY(-3px);
  box-shadow:0 8px 15px rgba(239,68,68,.3);
}

#printResult {
  margin-top:40px;
  border:2px solid var(--primary-light);
  padding:35px;
  border-radius:22px;
  background:#fff;
  display:none;
  box-shadow:var(--shadow-soft);
  animation:fadeInBounce .5s var(--transition-bounce);
}

@keyframes fadeInBounce {
  from {
    opacity:0;
    transform:translateY(30px);
  }
  to {
    opacity:1;
    transform:translateY(0);
  }
}

.result-header {
  border-bottom:2px solid var(--primary-light);
  padding-bottom:15px;
  margin-bottom:25px;
  display:flex;
  align-items:center;
  gap:12px;
  color:var(--primary-dark);
}

.result-header h2 {
  margin:0;
}

.patient-info-summary {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px 30px;
  background:#f8fafc;
  padding:20px;
  border-radius:14px;
  margin-bottom:30px;
  font-size:15px;
  border:1px solid #edf2f7;
}

#displaySummary {
  display:flex;
  flex-direction:column;
  gap:12px;
  margin-bottom:30px;
}

#displaySummary p {
  font-size:16px;
  margin:0;
  padding:16px 20px;
  border-left:5px solid var(--primary);
  background:var(--primary-light);
  border-radius:6px 14px 14px 6px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  box-shadow:0 2px 5px rgba(0,0,0,.02);
  transition:transform .2s ease;
}

#displaySummary p:hover {
  transform:translateX(4px);
}

.status-badge {
  padding:6px 16px;
  border-radius:20px;
  font-weight:bold;
  font-size:14px;
  display:inline-flex;
  align-items:center;
  gap:6px;
  box-shadow:0 2px 5px rgba(0,0,0,.05);
}

.risk-badge {
  background:#fee2e2;
  color:var(--danger-color);
  animation:shake .5s ease;
}

.normal-badge {
  background:#dcfce7;
  color:var(--success-color);
}

@keyframes shake {
  0%,100% {
    transform:translateX(0);
  }
  25% {
    transform:translateX(-4px);
  }
  75% {
    transform:translateX(4px);
  }
}

.risk {
  color:var(--danger-color);
  font-weight:bold;
}

.normal {
  color:var(--success-color);
  font-weight:bold;
}

#printTable {
  display:none;
}

.result-table {
  width:100%;
  border-collapse:collapse;
  margin-top:20px;
  border-radius:14px;
  overflow:hidden;
  box-shadow:var(--shadow-card);
}

.result-table th,
.result-table td {
  padding:14px 18px;
  text-align:left;
  font-size:15px;
}

.result-table th {
  background:var(--primary-dark);
  color:#fff;
  font-weight:600;
}

.result-table td {
  background:#fff;
  border-bottom:1px solid #e2e8f0;
  color:#334155;
}

.result-table tr:last-child td {
  border-bottom:none;
}

.result-table .valid-result td:last-child {
  color:var(--success-color);
  font-weight:bold;
}

.result-table .invalid-result td:last-child {
  color:var(--danger-color);
  font-weight:bold;
}

@media print {
  body {
    background:#fff;
    padding:0;
    margin:1cm;
  }

  .container {
    box-shadow:none;
    padding:0;
    border:none;
  }

  #snapForm,
  #calculateButton,
  #resetButton,
  #printButton {
    display:none;
  }

  #printResult {
    border:none;
    padding:0;
    display:block!important;
  }

  #displaySummary {
    display:none;
  }

  #printTable {
    display:block;
  }

  .result-table {
    border:2px solid #333;
    box-shadow:none;
  }

  .result-table th,
  .result-table td {
    border-color:#333;
    border-style:solid;
  }

  h1,h2,h3,h4,p {
    color:#000!important;
  }

  .risk {
    color:#d32f2f!important;
    -webkit-print-color-adjust:exact;
    print-color-adjust:exact;
  }

  .normal {
    color:#388e3c!important;
    -webkit-print-color-adjust:exact;
    print-color-adjust:exact;
  }

  .result-table .valid-result td:last-child {
    color:#388e3c!important;
    -webkit-print-color-adjust:exact;
    print-color-adjust:exact;
  }

  .result-table .invalid-result td:last-child {
    color:#d32f2f!important;
    -webkit-print-color-adjust:exact;
    print-color-adjust:exact;
  }
}

@media(max-width:768px) {
  .container {
    padding:25px 15px;
  }

  .info-grid {
    grid-template-columns:1fr;
    padding:15px;
  }

  .options-inline {
    grid-template-columns:repeat(2,1fr);
    gap:8px;
  }

  .form-buttons {
    flex-direction:column;
    gap:12px;
  }

  .form-buttons button {
    width:100%!important;
    justify-content:center;
  }

  .patient-info-summary {
    grid-template-columns:1fr;
    gap:10px;
  }

  #displaySummary p {
    flex-direction:column;
    align-items:flex-start;
    gap:5px;
  }
}
</style>
</head>

<body>

<div class="container" id="mainContainer">

  <div class="header-brand">

    <div class="brand-icon">
      <i class="fa-solid fa-magnifying-glass-chart"></i>
    </div>

    <h1>ADHD Smart Screen</h1>

    <p class="subtitle">
      แบบประเมินสมาธิสั้น (SNAP-IV) - โรงพยาบาลดอนจาน
    </p>

  </div>

  <form id="snapForm">

    <h2>
      <i class="fa-solid fa-id-card-clip"></i>
      ข้อมูลพื้นฐานของผู้รับบริการ
    </h2>

    <div class="info-grid">

      <div class="info-group">

        <label for="name">
          ชื่อผู้รับบริการ:
        </label>

        <input
          type="text"
          id="name"
          name="name"
          placeholder="ระบุชื่อ-นามสกุล"
          required
        >

      </div>

      <div class="info-group">

        <label for="date">
          วันที่ประเมิน:
        </label>

        <input
          type="date"
          id="date"
          name="date"
          required
        >

      </div>

      <div class="info-group">

        <label for="educationLevel">
          ระดับการศึกษา:
        </label>

        <select id="educationLevel" name="educationLevel" required>

          <option value="" disabled selected>
            --- เลือกระดับการศึกษา ---
          </option>

          <option value="ป.1">
            ประถมศึกษาปีที่ 1
          </option>

          <option value="ป.2">
            ประถมศึกษาปีที่ 2
          </option>

          <option value="ป.3">
            ประถมศึกษาปีที่ 3
          </option>

          <option value="ป.4">
            ประถมศึกษาปีที่ 4
          </option>

          <option value="ป.5">
            ประถมศึกษาปีที่ 5
          </option>

          <option value="ป.6">
            ประถมศึกษาปีที่ 6
          </option>

          <option value="มัธยมต้น">
            มัธยมศึกษาตอนต้น
          </option>

          <option value="มัธยมปลาย">
            มัธยมศึกษาตอนปลาย
          </option>

          <option value="อื่นๆ">
            อื่นๆ
          </option>

        </select>

      </div>

      <div class="info-group">

        <label>
          ประเมินโดย:
        </label>

        <div class="assessor-options">

          <div class="assessor-box">

            <input
              type="radio"
              name="assessor"
              value="ผู้ปกครอง"
              id="as_parent"
              required
            >

            <label for="as_parent">
              <i class="fa-solid fa-user-tie"></i>
              ผู้ปกครอง
            </label>

          </div>

          <div class="assessor-box">

            <input
              type="radio"
              name="assessor"
              value="ครู"
              id="as_teacher"
            >

            <label for="as_teacher">
              <i class="fa-solid fa-chalkboard-user"></i>
              ครู
            </label>

          </div>

        </div>

      </div>

    </div>

    <div class="instruction-banner">

      <i class="fa-solid fa-circle-info banner-icon"></i>

      <div>

        <strong>คำแนะนำสำหรับผู้ประเมิน:</strong>

        โปรดคลิกเลือกระดับความรุนแรงของอาการในแต่ละข้อตามที่ท่านสังเกตเห็นพฤติกรรมจริงในระยะนี้:

        <div class="instruction-legend">

          <span>
            <i
              class="fa-regular fa-face-smile"
              style="color:var(--lvl-0)"
            ></i>
            ไม่เลย (0)
          </span>

          <span>
            <i
              class="fa-regular fa-face-meh"
              style="color:var(--lvl-1)"
            ></i>
            เล็กน้อย (1)
          </span>

          <span>
            <i
              class="fa-regular fa-face-frown"
              style="color:var(--lvl-2)"
            ></i>
            ค่อนข้างมาก (2)
          </span>

          <span>
            <i
              class="fa-solid fa-face-grimace"
              style="color:var(--lvl-3)"
            ></i>
            มาก (3)
          </span>

        </div>

      </div>

    </div>

    <div id="questions"></div>

    <div class="form-buttons">

      <button
        type="button"
        onclick="calculateAndDisplay()"
        id="calculateButton"
      >
        <i class="fa-solid fa-calculator"></i>
        คำนวณผลคะแนนและแปลผล
      </button>

      <button
        type="button"
        onclick="printReport()"
        id="printButton"
      >
        <i class="fa-solid fa-print"></i>
        พิมพ์รายงาน
      </button>

      <button
        type="button"
        onclick="resetForm()"
        id="resetButton"
      >
        <i class="fa-solid fa-trash-can"></i>
        รีเซตข้อมูล
      </button>

    </div>

  </form>

  <div id="printResult">

    <div class="result-header">

      <i
        class="fa-solid fa-square-poll-vertical"
        style="font-size:26px"
      ></i>

      <h2>
        สรุปผลการประเมินพฤติกรรม ADHD Smart Screen (SNAP-IV)
      </h2>

    </div>

    <div class="patient-info-summary">

      <div>
        <strong>ชื่อผู้รับบริการ:</strong>
        <span id="displayName"></span>
      </div>

      <div>
        <strong>วันที่ประเมิน:</strong>
        <span id="displayDate"></span>
      </div>

      <div>
        <strong>ระดับการศึกษา:</strong>
        <span id="displayEducation"></span>
      </div>

      <div>
        <strong>ประเมินโดย:</strong>
        <span id="displayAssessor"></span>
      </div>

    </div>

    <div id="displaySummary"></div>

    <div
      id="descriptionPrint"
      style="
        margin-top:25px;
        padding:15px 20px;
        background:#f1f5f9;
        border-radius:12px;
        font-size:14px;
        border:1px solid #e2e8f0
      "
    >

      <h4
        style="
          color:var(--primary-dark);
          margin:0 0 8px;
          font-size:15px
        "
      >
        <i class="fa-solid fa-circle-exclamation"></i>
        เกณฑ์การแปลผลที่ใช้อ้างอิง (Cutoff Score)
      </h4>

      <p style="margin:3px 0">
        <strong>สำหรับผู้ปกครอง:</strong>
        ขาดสมาธิ ≥ 16 คะแนน,
        ซน/หุนหันพลันแล่น ≥ 14 คะแนน,
        ดื้อต่อต้าน ≥ 12 คะแนน
      </p>

      <p style="margin:3px 0">
        <strong>สำหรับครู:</strong>
        ขาดสมาธิ ≥ 18 คะแนน,
        ซน/หุนหันพลันแล่น ≥ 11 คะแนน,
        ดื้อต่อต้าน ≥ 8 คะแนน
      </p>

    </div>

    <div id="printTable"></div>

  </div>

</div>

<script>

const questionData = [

[
  "ด้านขาดสมาธิ",
  "ข้อ 1-9",
  "fa-head-side-virus",
  "var(--inattention-color)",
  [
    "มักไม่ละเอียดรอบคอบหรือสะเพร่าในการทำงานต่าง ๆ เช่น การบ้าน",
    "ทำอะไรนาน ๆ ไม่ได้",
    "ดูเหมือนไม่ค่อยฟังเวลามีคนพูดด้วย",
    "ทำตามคำสั่งไม่ค่อยครบ เช่น ไม่ค่อยทำการบ้านให้เสร็จ",
    "จัดระเบียบงานและกิจกรรมต่าง ๆ ไม่เป็น",
    "มักหลีกเลี่ยงกิจกรรมที่ต้องใช้ความอดทนในการทำให้สำเร็จ",
    "ทำของหายบ่อย ๆ เช่น ของเล่น สมุดจดงาน เครื่องเขียน",
    "วอกแวกง่าย",
    "ขี้ลืม"
  ]
],

[
  "ด้านซน อยู่ไม่นิ่ง/หุนหันพลันแล่น",
  "ข้อ 10-18",
  "fa-child-holding-hands",
  "var(--hyperactivity-color)",
  [
    "มือเท้ายุกยิก นั่งบิดไปบิดมา",
    "นั่งไม่ติดที่ ชอบลุกจากที่นั่งในชั้นเรียนหรือจากที่ที่ควรจะนั่งเรียบร้อย",
    "วิ่งหรือปีนป่ายมากเกินควรอย่างไม่รู้กาลเทศะ",
    "เล่นหรือทำกิจกรรมเงียบ ๆ ไม่เป็น",
    "พร้อมจะเคลื่อนไหวอยู่เสมอ เหมือน \"ติดเครื่อง\" อยู่ตลอดเวลา",
    "พูดมาก",
    "มักโพล่งคำตอบออกมาก่อนจะฟังคําถามจบ",
    "ไม่ชอบรอคิว",
    "ชอบสอดแทรกผู้อื่น (เช่น พูดแทรกขณะผู้ใหญ่กำลังสนทนากัน)"
  ]
],

[
  "ด้านดื้อต่อต้าน",
  "ข้อ 19-26",
  "fa-face-angry",
  "var(--oppositional-color)",
  [
    "อารมณ์เสียง่าย",
    "ชอบโต้เถียงกับผู้ใหญ่",
    "ไม่ยอมทำตามสิ่งที่ผู้ใหญ่สั่งหรือวางกฎเกณฑ์ไว้",
    "จงใจก่อกวนผู้อื่น",
    "มักตำหนิผู้อื่นในสิ่งที่ตนเองทำผิด",
    "ขี้รำคาญ",
    "โกรธขึ้งบึ้งตึงเป็นประจำ",
    "เจ้าคิดเจ้าแค้น"
  ]
]

];

const answerLabels = [

  [
    "fa-regular fa-face-smile",
    "ไม่เลย",
    "0"
  ],

  [
    "fa-regular fa-face-meh",
    "เล็กน้อย",
    "1"
  ],

  [
    "fa-regular fa-face-frown",
    "ค่อนข้างมาก",
    "2"
  ],

  [
    "fa-solid fa-face-grimace",
    "มาก",
    "3"
  ]

];

function renderQuestions() {

  let qNo = 1;
  let html = "";

  for (const group of questionData) {

    html += `
      <div class="question-group">

        <h3>
          <i
            class="fa-solid ${group[2]}"
            style="color:${group[3]}"
          ></i>

          ${group[0]} (${group[1]})

        </h3>
    `;

    for (const text of group[4]) {

      html += `
        <div class="question">

          <label>
            ${qNo}. ${text}
          </label>

          <div class="options-inline">
      `;

      for (const a of answerLabels) {

        const id = `q${qNo}_${a[2]}`;

        html += `
          <input
            type="radio"
            name="q${qNo}"
            id="${id}"
            value="${a[2]}"
            ${a[2] === "0" ? "required" : ""}
          >

          <label for="${id}">
            <i class="${a[0]}"></i>
            ${a[1]}
            <span>(${a[2]})</span>
          </label>
        `;

      }

      html += `
          </div>
        </div>
      `;

      qNo++;

    }

    html += `
      </div>
    `;

  }

  document.getElementById("questions").innerHTML = html;

}

function formatDate(dateString) {

  if (!dateString) return "";

  const parts = dateString.split("-");

  return `${parts[2]}/${parts[1]}/${parts[0]}`;

}

function calculateAndDisplay() {

  const form = document.forms["snapForm"];

  const assessor =
    document.querySelector('input[name="assessor"]:checked');

  const educationLevel =
    document.getElementById("educationLevel");

  if (
    !assessor ||
    !educationLevel.value ||
    !form.name.value ||
    !form.date.value
  ) {

    alert(
      "กรุณากรอกข้อมูลพื้นฐานและเลือกผู้ประเมินให้ครบถ้วน"
    );

    return false;

  }

  const assessorType = assessor.value;

  let inattention = 0;
  let hyperactivity = 0;
  let oppositional = 0;
  let firstUnanswered = -1;

  document.querySelectorAll(".question").forEach(q => {

    q.style.borderBottom =
      "1px solid #edf2f7";

    q.style.backgroundColor =
      "transparent";

  });

  for (let i = 1; i <= 26; i++) {

    const selected =
      document.querySelector(
        `input[name="q${i}"]:checked`
      );

    if (!selected) {

      if (firstUnanswered === -1) {
        firstUnanswered = i;
      }

      continue;

    }

    const val =
      parseInt(selected.value, 10);

    if (i <= 9) {

      inattention += val;

    } else if (i <= 18) {

      hyperactivity += val;

    } else {

      oppositional += val;

    }

  }

  if (firstUnanswered !== -1) {

    alert(
      "กรุณาตอบคำถามข้อที่ " +
      firstUnanswered +
      " ให้ครบถ้วน"
    );

    const q =
      document
        .querySelector(
          `input[name="q${firstUnanswered}"]`
        )
        ?.closest(".question");

    if (q) {

      q.style.backgroundColor = "#fef2f2";

      q.scrollIntoView({
        behavior:"smooth",
        block:"center"
      });

    }

    return false;

  }

  const cutoffs = {

    "ผู้ปกครอง": {
      inattention:16,
      hyperactivity:14,
      oppositional:12
    },

    "ครู": {
      inattention:18,
      hyperactivity:11,
      oppositional:8
    }

  };

  const cutoff =
    cutoffs[assessorType];

  const ia =
    inattention >= cutoff.inattention;

  const hy =
    hyperactivity >= cutoff.hyperactivity;

  const op =
    oppositional >= cutoff.oppositional;

  const badge = (risk) => {

    return risk

      ? `
        <span class="status-badge risk-badge">
          <i class="fa-solid fa-triangle-exclamation"></i>
          เสี่ยง
        </span>
      `

      : `
        <span class="status-badge normal-badge">
          <i class="fa-solid fa-circle-check"></i>
          ปกติ
        </span>
      `;

  };

  document.getElementById("displaySummary").innerHTML = `

    <p>

      <span>

        <i
          class="fa-solid fa-head-side-virus"
          style="
            color:var(--inattention-color);
            margin-right:8px
          "
        ></i>

        <strong>
          ด้านขาดสมาธิ (1-9):
        </strong>

        คะแนนรวม ${inattention} คะแนน
        (เกณฑ์สำหรับ${assessorType} ≥ ${cutoff.inattention})

      </span>

      ${badge(ia)}

    </p>

    <p>

      <span>

        <i
          class="fa-solid fa-child-holding-hands"
          style="
            color:var(--hyperactivity-color);
            margin-right:8px
          "
        ></i>

        <strong>
          ด้านซน/หุนหันพลันแล่น (10-18):
        </strong>

        คะแนนรวม ${hyperactivity} คะแนน
        (เกณฑ์สำหรับ${assessorType} ≥ ${cutoff.hyperactivity})

      </span>

      ${badge(hy)}

    </p>

    <p>

      <span>

        <i
          class="fa-solid fa-face-angry"
          style="
            color:var(--oppositional-color);
            margin-right:8px
          "
        ></i>

        <strong>
          ด้านดื้อต่อต้าน (19-26):
        </strong>

        คะแนนรวม ${oppositional} คะแนน
        (เกณฑ์สำหรับ${assessorType} ≥ ${cutoff.oppositional})

      </span>

      ${badge(op)}

    </p>

  `;

  document.getElementById("printTable").innerHTML = `

    <table class="result-table">

      <thead>

        <tr>

          <th>
            ด้านที่ประเมิน
          </th>

          <th style="text-align:center">
            คะแนนที่ได้ (เต็ม)
          </th>

          <th style="text-align:center">
            เกณฑ์ตัดสินจุดตัด (Cut-off)
          </th>

          <th style="text-align:center">
            ผลการแปลความหมาย
          </th>

        </tr>

      </thead>

      <tbody>

        <tr class="${ia ? "invalid-result" : "valid-result"}">

          <td>
            ด้านขาดสมาธิ (Inattention)
            (ข้อ 1-9)
          </td>

          <td style="text-align:center;font-weight:500">
            ${inattention} (27)
          </td>

          <td style="text-align:center">
            ≥ ${cutoff.inattention}
          </td>

          <td style="text-align:center">
            ${ia ? "เสี่ยง" : "ปกติ"}
          </td>

        </tr>

        <tr class="${hy ? "invalid-result" : "valid-result"}">

          <td>
            ด้านซน อยู่ไม่นิ่ง/หุนหันพลันแล่น
            (Hyperactivity) (ข้อ 10-18)
          </td>

          <td style="text-align:center;font-weight:500">
            ${hyperactivity} (27)
          </td>

          <td style="text-align:center">
            ≥ ${cutoff.hyperactivity}
          </td>

          <td style="text-align:center">
            ${hy ? "เสี่ยง" : "ปกติ"}
          </td>

        </tr>

        <tr class="${op ? "invalid-result" : "valid-result"}">

          <td>
            ด้านดื้อต่อต้าน
            (Oppositional Defiant Disorder)
            (ข้อ 19-26)
          </td>

          <td style="text-align:center;font-weight:500">
            ${oppositional} (24)
          </td>

          <td style="text-align:center">
            ≥ ${cutoff.oppositional}
          </td>

          <td style="text-align:center">
            ${op ? "เสี่ยง" : "ปกติ"}
          </td>

        </tr>

      </tbody>

    </table>

  `;

  document.getElementById("displayName").textContent =
    form.name.value;

  document.getElementById("displayDate").textContent =
    formatDate(form.date.value);

  document.getElementById("displayEducation").textContent =
    educationLevel.value;

  document.getElementById("displayAssessor").textContent =
    assessorType;

  document.getElementById("printResult").style.display =
    "block";

  document.getElementById("printResult").scrollIntoView({
    behavior:"smooth"
  });

  return true;

}

function printReport() {

  if (!calculateAndDisplay()) {
    return;
  }

  const reportContent =
    document.getElementById("printResult").innerHTML;

  const name =
    document.getElementById("displayName").textContent;

  const htmlContent = `

<!DOCTYPE html>

<html lang="th">

<head>

<meta charset="UTF-8">

<title>
รายงานผล ADHD Smart Screen (${name})
</title>

<link
  href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;600;700&display=swap"
  rel="stylesheet"
>

<style>

body {
  font-family:'Sarabun',sans-serif;
  padding:20px;
  color:#333;
  margin:1cm;
  font-size:16px;
}

h1 {
  color:#1565c0;
  text-align:center;
  margin-bottom:5px;
  font-size:24px;
}

h2 {
  color:#1565c0;
  text-align:center;
  margin-top:5px;
  border-bottom:2px solid #1565c0;
  padding-bottom:10px;
  font-size:20px;
}

h4 {
  color:#1565c0;
  margin-top:20px;
  border-bottom:1px dashed #ccc;
  padding-bottom:3px;
}

p {
  margin:8px 0;
  font-size:15px;
}

.patient-info-summary {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
  background:#f8fafc;
  padding:15px;
  border-radius:8px;
  margin-bottom:20px;
  border:1px solid #e2e8f0;
}

.result-table {
  width:100%;
  border-collapse:collapse;
  margin-top:15px;
}

.result-table th,
.result-table td {
  border:1px solid #333;
  padding:10px;
  font-size:15px;
}

.result-table th {
  background:#e3f2fd;
  color:#000;
  text-align:center;
  font-weight:bold;
}

.valid-result td:last-child {
  color:#388e3c!important;
  font-weight:bold;
  text-align:center;
}

.invalid-result td:last-child {
  color:#d32f2f!important;
  font-weight:bold;
  text-align:center;
}

#displaySummary {
  display:none;
}

#printResult {
  display:block;
  border:none;
  padding:0;
}

#printTable {
  display:block;
}

</style>

</head>

<body>

<h1>
ADHD Smart Screen (SNAP-IV)
</h1>

<p
  style="
    text-align:center;
    margin-bottom:25px;
    color:#555
  "
>
โรงพยาบาลดอนจาน - รายงานสรุปผลการคัดกรอง
</p>

${reportContent}

</body>

</html>

`;

  const printWindow =
    window.open(
      "",
      "_blank",
      "height=700,width=900"
    );

  if (!printWindow) {

    alert(
      "ไม่สามารถเปิดหน้าพิมพ์ได้ กรุณาอนุญาต Pop-up ของเว็บไซต์นี้"
    );

    return;

  }

  printWindow.document.open();

  printWindow.document.write(
    htmlContent
  );

  printWindow.document.close();

  printWindow.focus();

  setTimeout(
    () => printWindow.print(),
    300
  );

}

function resetForm() {

  if (
    !confirm(
      "คุณแน่ใจหรือไม่ว่าต้องการรีเซ็ตข้อมูลทั้งหมด?"
    )
  ) {
    return;
  }

  document
    .getElementById("snapForm")
    .reset();

  document
    .getElementById("printResult")
    .style.display = "none";

  document
    .getElementById("displaySummary")
    .innerHTML = "";

  document
    .getElementById("printTable")
    .innerHTML = "";

  document
    .querySelectorAll(".question")
    .forEach(q => {

      q.style.borderBottom =
        "1px solid #edf2f7";

      q.style.backgroundColor =
        "transparent";

    });

  document
    .getElementById("mainContainer")
    .scrollIntoView({
      behavior:"smooth"
    });

}

/* ================================
   PWA SERVICE WORKER
================================ */

if ("serviceWorker" in navigator) {

  window.addEventListener(
    "load",
    () => {

      navigator.serviceWorker
        .register("./sw.js")
        .then(
          reg => console.log(
            "ADHD Smart Check Service Worker registered",
            reg.scope
          )
        )
        .catch(
          err => console.error(
            "Service Worker registration failed",
            err
          )
        );

    }
  );

}

/* ================================
   DEFAULT ASSESSMENT DATE
================================ */

document.addEventListener(
  "DOMContentLoaded",
  () => {

    renderQuestions();

    const dateInput =
      document.getElementById("date");

    if (
      dateInput &&
      !dateInput.value
    ) {

      const now = new Date();

      const local =
        new Date(
          now.getTime() -
          now.getTimezoneOffset() * 60000
        );

      dateInput.value =
        local.toISOString().slice(0,10);

    }

  }
);

</script>

</body>
</html>
